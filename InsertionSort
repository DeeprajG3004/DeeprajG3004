#include <stdio.h>

void insertionSort(int arr[], int size){
    for(int step = 1; step < size; step++){
        int key = arr[step];
        int j = step - 1;

        while (j>=0 && key < arr[j]){
            arr[j + 1] = arr[j];
            --j;
        }
        arr[j + 1] = key;
    }
}
int main(){
    int data[]={3,7,1,9,4,8,6,2};
    int size=sizeof(data)/sizeof(data[0]);
    insertionSort(data,size);
    printf("Sorted array: \n");
    for(int i=0;i<size;i++){
        printf("%d ",data[i]);
    }
    return 0;
}
